# Copy this file to .dev.vars for local development.
# These are used by `npm run dev:worker` (wrangler dev).

# Your YNAB Personal Access Token
# Get it from: https://app.ynab.com/settings/developer
YNAB_API_TOKEN=your_ynab_personal_access_token_here

# Read key: connects with read tools only (list/get). Long random string:
#   openssl rand -hex 32
MCP_AUTH_KEY=your_read_key_here

# Write key: connects with ALL tools (create/update/delete/import).
# Must differ from MCP_AUTH_KEY. Leave unset to make writes impossible.
MCP_WRITE_KEY=your_write_key_here
