# Copy this file to .dev.vars for local development.
# These are used by `npm run dev:worker` (wrangler dev).

# Your YNAB Personal Access Token
# Get it from: https://app.ynab.com/settings/developer
YNAB_API_TOKEN=your_ynab_personal_access_token_here

# A secret key that only you know — used to authenticate your MCP client connections.
# Make it a long random string, e.g.: openssl rand -hex 32
MCP_AUTH_KEY=your_secret_key_here

# Read-only by default (only tools with readOnlyHint are exposed).
# Set to "false" to also expose create/update/delete/import tools.
# READ_ONLY=false
