{
  "name": "ynab-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the YNAB (You Need A Budget) API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ynab-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:remote": "tsx watch src/express.ts",
    "dev:worker": "wrangler dev",
    "start": "node dist/index.js",
    "start:remote": "node dist/express.js",
    "start:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgarcia/ynab-mcp-server.git"
  },
  "license": "ISC",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ynab": "^4.1.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.111.0"
  }
}
